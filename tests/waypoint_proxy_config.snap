---
apiVersion: v1
items:
- apiVersion: v1
  data:
    deployment: |-
      "spec":
        "template":
          "metadata":
            "annotations":
              "scaleops.sh/default-rightsize-policy": "high-availability"
          "spec":
            "containers":
            - "name": "istio-proxy"
              "resources":
                "limits":
                  "memory": "1Gi"
                "requests":
                  "cpu": "500m"
                  "memory": "200Mi"
            "nodeSelector":
              "outreach.io/nodepool": "ondemand"
            "priorityClassName": "system-cluster-critical"
            "tolerations":
            - "effect": "NoSchedule"
              "key": "dedicated"
              "operator": "Equal"
              "value": "ondemand"
            "topologySpreadConstraints":
            - "labelSelector":
                "matchLabels":
                  "gateway.networking.k8s.io/gateway-name": "test-waypoint"
              "maxSkew": 1
              "topologyKey": "topology.kubernetes.io/zone"
              "whenUnsatisfiable": "DoNotSchedule"
    horizontalPodAutoscaler: |-
      "spec":
        "maxReplicas": 6
        "metrics":
        - "resource":
            "name": "cpu"
            "target":
              "averageUtilization": 80
              "type": "Utilization"
          "type": "Resource"
        "minReplicas": 2
        "scaleTargetRef":
          "apiVersion": "apps/v1"
          "kind": "Deployment"
          "name": "test-waypoint"
    podDisruptionBudget: |-
      "spec":
        "minAvailable": 1
  kind: ConfigMap
  metadata:
    annotations:
      argocd.argoproj.io/sync-wave: "-4"
    labels:
      app: test-team
      name: test-waypoint
      reporting_team: test-team
    name: test-waypoint
    namespace: test-ns
- apiVersion: monitoring.coreos.com/v1
  kind: PodMonitor
  metadata:
    annotations: {}
    labels:
      app: test-waypoint
      name: test-waypoint
    name: test-waypoint
    namespace: test-ns
  spec:
    jobLabel: name
    podMetricsEndpoints:
    - honorLabels: true
      interval: 30s
      metricRelabelings:
      - replacement: "30"
        targetLabel: outreach_metric_collection_interval
      - action: labeldrop
        regex: source_principal|destination_principal|source_canonical_service|destination_canonical_service|source_canonical_revision|destination_canonical_revision|source_cluster|destination_cluster
      - action: drop
        regex: istio_agent_.*|istiod_.*|citadel_.*|galley_.*|envoy_cluster_[^u].*|envoy_cluster_update.*|envoy_listener_[^dh].*|envoy_server_[^mu].*|envoy_wasm_.*
        sourceLabels:
        - __name__
      path: /stats/prometheus
      port: http-envoy-prom
    podTargetLabels:
    - name
    - reporting_team
    selector:
      matchLabels:
        name: test-waypoint
kind: List
